{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "workLog",
  "version": "0.1.0",
  "identifier": "com.worklog.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "workLog",
        "width": 480,
        "height": 720,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "workLog",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../resources/*"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
