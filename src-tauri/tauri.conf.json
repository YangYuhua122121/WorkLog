{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "workLog",
  "version": "0.2.4",
  "identifier": "com.worklog.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "clip",
        "title": "workLog",
        "url": "clip.html",
        "width": 138,
        "height": 66,
        "minWidth": 80,
        "minHeight": 48,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "noRedirectionBitmap": true
      },
      {
        "label": "board",
        "title": "workLog",
        "url": "index.html",
        "width": 480,
        "height": 680,
        "minWidth": 480,
        "minHeight": 680,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "visible": false,
        "shadow": false,
        "acceptFirstMouse": true,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "workLog",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
